+class Test_sanitize_filepath_drive_relative:
+    """Drive-relative paths must not be silently turned into absolute paths.
+
+    ``ntpath.splitdrive("C:foo")`` yields ``("C:", "foo")``. Joining the drive back
+    with a separator produced ``"C:\\foo"``, which is absolute: it changes the
+    meaning of the path and, because ``os.path.join`` discards its first argument
+    when the second is absolute, it escapes the directory the caller intended to
+    confine the result to. It also made ``sanitize_filepath`` return a value that
+    ``validate_filepath`` rejects for ``platform="universal"``.
+    """
+
+    @pytest.mark.parametrize(
+        ["value", "platform", "expected"],
+        [
+            ["C:x.txt", "windows", "C:x.txt"],
+            ["C:x.txt", "universal", "C:x.txt"],
+            ["D:payload.exe", "windows", "D:payload.exe"],
+            ["C:.\\y.txt", "windows", "C:y.txt"],
+            ["C:..\\..\\evil.txt", "windows", "C:..\\..\\evil.txt"],
+        ],
+    )
+    def test_normal_drive_relative_stays_relative(self, value, platform, expected):
+        sanitized = sanitize_filepath(value, platform=platform)
+
+        assert sanitized == expected
+        assert not ntpath.isabs(sanitized)
+
+    @pytest.mark.parametrize(
+        ["value", "platform"],
+        [
+            ["C:x.txt", "universal"],
+            ["C:..\\..\\evil.txt", "universal"],
+            ["D:payload.exe", "universal"],
+            ["C:.\\y.txt", "universal"],
+        ],
+    )
+    def test_normal_valid_in_valid_out(self, value, platform):
+        """A path the validator accepts must not be sanitized into a rejected one."""
+        validate_filepath(value, platform=platform)
+
+        sanitized = sanitize_filepath(value, platform=platform)
+
+        validate_filepath(sanitized, platform=platform)
+        assert is_valid_filepath(sanitized, platform=platform)
+
+        # the strict mode must agree with the default mode
+        assert (
+            sanitize_filepath(value, platform=platform, validate_after_sanitize=True) == sanitized
+        )
+
+    @pytest.mark.parametrize(
+        ["value", "platform", "expected"],
+        [
+            ["C:\\x.txt", "windows", "C:\\x.txt"],
+            ["C:/x.txt", "windows", "C:\\x.txt"],
+        ],
+    )
+    def test_normal_absolute_drive_is_unchanged(self, value, platform, expected):
+        """Pre-existing absolute-path behaviour must be preserved."""
+        sanitized = sanitize_filepath(value, platform=platform)
+
+        assert sanitized == expected
+        assert ntpath.isabs(sanitized)
+
+    @pytest.mark.parametrize("value", ["C:\\", "C:/"])
+    def test_normal_drive_root_is_unchanged(self, value):
+        """A bare drive root loses its separator; this predates the fix and is kept."""
+        assert sanitize_filepath(value, platform="windows") == "C:"
