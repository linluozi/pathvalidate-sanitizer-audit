+def escape_replacement_text(replacement_text: str) -> str:
+    """Escape a string so that it is treated as literal text by :py:meth:`re.Pattern.sub`.
+
+    ``re.sub`` expands backslash escapes and group references (``\\1``, ``\\g<0>``)
+    in its replacement argument.  ``replacement_text`` is a plain literal, so any
+    escape sequence in it must reach the output unchanged instead of being
+    interpreted.  Using an unescaped value either raises ``re.error`` (which is not
+    a :py:class:`ValueError` and so escapes the documented error contract) or
+    silently emits a different character (e.g. ``"\\\\b"`` becomes a backspace).
+
+    Args:
+        replacement_text:
+            Replacement text as specified by the caller.
+
+    Returns:
+        str: The replacement text with substitution escapes neutralized.
+    """
+
+    if not replacement_text:
+        return replacement_text
+
+    return replacement_text.replace("\\", "\\\\")
+
+
 def replace_unprintable_char(text: str, replacement_text: str = "") -> str:
     try:
